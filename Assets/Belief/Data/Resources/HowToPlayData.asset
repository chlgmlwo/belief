  m_Script: {fileID: 11500000, guid: 3186e29b1df814c488b9f47572ef5441, type: 3}
  m_Name: HowToPlayData
  m_EditorClassIdentifier: Assembly-CSharp::Belief.Data.HowToPlayData
  pages:
  - title: "BELIEF\uB780?"
    body: "\uC815\uBCF4\uB294 \uC0AC\uB78C\uB4E4\uC758 \uBBFF\uC74C\uC744 \uBC14\uAFB8\uACE0\n\uBBFF\uC74C\uC740
      \uC0AC\uB78C\uB4E4\uC758 \uD589\uB3D9\uC744 \uBC14\uAFC9\uB2C8\uB2E4.\n\n\uB2F9\uC2E0\uC740
      \uC815\uBCF4\uB97C \uD37C\uB728\uB824\n\uC138\uC0C1\uC744 \uC6D0\uD558\uB294
      \uBC29\uD5A5\uC73C\uB85C \uC6C0\uC9C1\uC5EC\uC57C \uD569\uB2C8\uB2E4."
  - title: "\uD50C\uB808\uC774 \uD750\uB984"
    body: "\u2460 \uC815\uBCF4\uB97C \uC120\uD0DD\uD55C\uB2E4.\n\n\u2461 \uC7A5\uC18C\uB97C
      \uC120\uD0DD\uD55C\uB2E4.\n\n\u2462 \uC804\uB2EC\uC790\uB97C \uC120\uD0DD\uD55C\uB2E4.\n\n\u2463
      \uC815\uBCF4\uB97C \uC804\uB2EC\uD55C\uB2E4.\n\n\u2464 NPC\uB4E4\uC774 \uD589\uB3D9\uD55C\uB2E4."
  - title: "\uC815\uBCF4"
    body: "\uC815\uBCF4\uB9C8\uB2E4\n\uCD9C\uCC98, \uD655\uC2E0\uB3C4, \uC601\uD5A5\uB825
      \uB4F1\uC774 \uB2E4\uB97C \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uAC19\uC740
      \uC815\uBCF4\uB77C\uB3C4\n\uB204\uAC00 \uD37C\uB728\uB9AC\uB290\uB0D0\uC5D0
      \uB530\uB77C\n\uACB0\uACFC\uAC00 \uB2EC\uB77C\uC9C8 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - title: Mission
    body: "Mission\uC740\nNPC\uB97C \uC9C1\uC811 \uC870\uC885\uD558\uB294 \uAC83\uC774
      \uC544\uB2C8\uB77C\n\n\uC815\uBCF4\uB97C \uC774\uC6A9\uD574\n\uC2A4\uC2A4\uB85C
      \uD589\uB3D9\uD558\uB3C4\uB85D \uB9CC\uB4DC\uB294 \uAC83\uC774\n\uBAA9\uD45C\uC785\uB2C8\uB2E4."
  - title: "\uC815\uB2F5\uC740 \uD558\uB098\uAC00 \uC544\uB2D9\uB2C8\uB2E4"
    body: "\uC815\uBCF4\uB97C \uC870\uD569\uD558\uC5EC\n\uB2F9\uC2E0\uB9CC\uC758
      \uBC29\uC2DD\uC73C\uB85C\nMission\uC744 \uD574\uACB0\uD574 \uBCF4\uC138\uC694."
