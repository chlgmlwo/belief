  m_Name: Npc_Major_LowRankGuard
  m_EditorClassIdentifier: Assembly-CSharp::Belief.Data.MajorNpcData
  npcId: npc_major_lowrank_guard
  displayName: "\uD558\uAE09 \uACBD\uBE44\uBCD1"
  homeLocation: {fileID: 11400000, guid: 251b99d1b087f3247bd9fe8501d0891e, type: 2}
  gender: "\uB0A8\uC131"
  job: "\uACBD\uBE44\uBCD1"
  affiliation: "1\uC2A4\uD14C\uC774\uC9C0 \uBD81\uBB38(\uC678\uACFD) \uACBD\uBE44\uCD08\uC18C"
  gameplayRoleSummary: "\uACBD\uBE44\uB300\uC7A5\uC758 \uBD80\uD558\uC774\uC790 \uBA85\uB839\xB7\uBCF4\uACE0
    \uC804\uB2EC NPC"
  aiNotes:
  - "\uC785\uB300\uD55C \uC9C0 \uC5BC\uB9C8 \uB418\uC9C0 \uC54A\uC740 \uC2E0\uBCD1\uC774\uB2E4."
  - "\uC2E4\uC804 \uACBD\uD5D8\uC774 \uAC70\uC758 \uC5C6\uC5B4 \uC2A4\uC2A4\uB85C
    \uD310\uB2E8\uD574\uC57C \uD560 \uB54C \uBD88\uC548\uD574\uD55C\uB2E4."
  - "\uD2C0\uB824\uC11C \uD63C\uB098\uB294 \uAC83\uBCF4\uB2E4 \uBAA8\uB4E0 \uAC83\uC744
    \uBCF4\uACE0\uD574 \uCC45\uC784\uC744 \uB098\uB204\uB294 \uCABD\uC744 \uC120\uD638\uD55C\uB2E4."
  - "\uB204\uAD6C\uC5D0\uAC8C\uB098 \uC874\uB313\uB9D0\uC744 \uC4F0\uACE0 \uB9D0\uB05D\uC744
    \uD750\uB9B0\uB2E4."
  backstory: "\uC785\uB300\uD55C \uC9C0 \uC5BC\uB9C8 \uB418\uC9C0 \uC54A\uC740 \uC2E0\uBCD1\uC774\uB2E4.
    \uD3C9\uBC94\uD55C \uC9D1\uC548 \uCD9C\uC2E0\uC73C\uB85C \uC548\uC815\uC801\uC778
    \uC77C\uC790\uB9AC\uB97C \uCC3E\uC544 \uACBD\uBE44\uB300\uC5D0 \uC9C0\uC6D0\uD588\uB2E4.
    \uC544\uC9C1 \uC2E4\uC804 \uACBD\uD5D8\uC774 \uAC70\uC758 \uC5C6\uC5B4 \uC2A4\uC2A4\uB85C
    \uD310\uB2E8\uD574\uC57C \uD560 \uC0C1\uD669\uC774 \uC624\uBA74 \uBD88\uC548\uD574\uD558\uBA70,
    \uC77C\uB2E8 \uC704\uC5D0 \uBB3C\uC5B4\uBCF4\uB294 \uAC8C \uB9C8\uC74C \uD3B8\uD558\uB2E4.
    \uAC00\uC7A5 \uC911\uC694\uD558\uAC8C \uC5EC\uAE30\uB294 \uAC74 \uC0AC\uACE0\uAC00
    \uB098\uC9C0 \uC54A\uB294 \uAC83\uC774\uB77C, \uD310\uB2E8\uD558\uB2E4 \uD2C0\uB824
    \uD63C\uB098\uAE30\uBCF4\uB2E4 \uBAA8\uB4E0 \uAC83\uC744 \uBCF4\uACE0\uD574 \uCC45\uC784\uC744
    \uB098\uB204\uB294 \uCABD\uC744 \uD0DD\uD55C\uB2E4."
  judgmentTendencyTag: "#\uC21C\uC751\uD615"
  priorityTag: "#\uC548\uC804\uC81C\uC77C"
