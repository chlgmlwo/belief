  m_Name: Npc_Major_MerchantHead
  m_EditorClassIdentifier: Assembly-CSharp::Belief.Data.MajorNpcData
  npcId: npc_major_merchant_head
  displayName: "\uC0C1\uC778"
  homeLocation: {fileID: 11400000, guid: dca044554a3207f4fb1a617e67fa6eaf, type: 2}
  gender: "\uB0A8\uC131"
  job: "\uC0C1\uC778"
  affiliation: "1\uC2A4\uD14C\uC774\uC9C0 \uBD81\uBB38(\uC678\uACFD) \uC2DC\uC7A5"
  gameplayRoleSummary: "\uC2E4\uB9AC\uC801 \uC815\uBCF4\uC6D0\uC774\uBA70 \uACBD\uBE44\uB300\uC7A5\uACFC\uC758
    \uAC70\uB798 \uAD00\uACC4\uB97C \uD1B5\uD574 \uC815\uBCF4\uB97C \uC787\uB294
    NPC"
  aiNotes:
  - "\uC2DC\uC7A5 \uBC11\uBC14\uB2E5\uC758 \uC88C\uD310\uC5D0\uC11C \uC2DC\uC791\uD55C
    \uC790\uC218\uC131\uAC00\uD55C \uC0C1\uC778\uC774\uB2E4."
  - "\uC218\uC2ED \uB144\uAC04 \uB2E4\uC9C4 \uC9C0\uC5ED \uC778\uB9E5\uC774 \uB450\uD141\uB2E4."
  - "\uC0AC\uB78C\uC758 \uB9D0\uBCF4\uB2E4 \uC22B\uC790\uC640 \uADFC\uAC70\uB97C
    \uC2E0\uB8B0\uD55C\uB2E4."
  - "\uBAA8\uB4E0 \uC815\uBCF4\uB97C \uBA3C\uC800 \uC190\uC775\uC73C\uB85C \uACC4\uC0B0\uD55C\uB2E4."
  backstory: "\uD074\uB808\uB974\uD3F0 \uC2DC\uC7A5 \uBC11\uBC14\uB2E5\uC5D0\uC11C
    \uC88C\uD310 \uD558\uB098\uB85C \uC7A5\uC0AC\uB97C \uC2DC\uC791\uD574 \uC9C0\uAE08\uC740
    \uC2DC\uC7A5\uC5D0\uC11C \uC190\uAF3D\uD788\uB294 \uC0C1\uC810\uC744 \uAC00\uC9C4
    \uC790\uC218\uC131\uAC00\uD55C \uC778\uBB3C\uC774\uB2E4. \uD654\uB824\uD55C \uBB34\uC5ED
    \uC778\uB9E5\uC740 \uC5C6\uC9C0\uB9CC \uC218\uC2ED \uB144\uAC04 \uC2DC\uC7A5
    \uBC14\uB2E5\uC744 \uAD6C\uB974\uBA70 \uB2E4\uC9C4 \uC9C0\uC5ED \uC778\uB9E5\uB9CC\uD07C\uC740
    \uB204\uAD6C\uBCF4\uB2E4 \uB450\uD141\uB2E4. \uBB34\uC5C7\uC774\uB4E0 \uC774\uB4DD\uC774
    \uB418\uB294\uAC00\uB97C \uBA3C\uC800 \uB530\uC9C0\uACE0, \uC624\uB79C \uC7A5\uC0AC
    \uACBD\uD5D8\uC73C\uB85C \uC0AC\uB78C\uC758 \uB9D0\uBCF4\uB2E4 \uC22B\uC790\uC640
    \uADFC\uAC70\uB97C \uC2E0\uB8B0\uD558\uB294 \uBC95\uC744 \uBC30\uC6E0\uB2E4."
  judgmentTendencyTag: "#\uC2E0\uC911\uD615"
  priorityTag: "#\uC774\uC775\uC6B0\uC120"
