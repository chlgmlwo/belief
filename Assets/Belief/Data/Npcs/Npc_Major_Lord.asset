  displayName: "\uC601\uC8FC"
  homeLocation: {fileID: 11400000, guid: 7946e2d0d9aa347439dafacb692c0b88, type: 2}
  gender: "\uB0A8\uC131"
  job: "\uD074\uB808\uB974\uD3F0 \uC601\uC8FC"
  affiliation: "4\uC2A4\uD14C\uC774\uC9C0 \uB3C4\uC2DC \uD1B5\uD569\xB7\uD30C\uC774\uB110"
  gameplayRoleSummary: "\uCD5C\uC885 \uD074\uB9AC\uC5B4 \uBAA9\uD45C \uB300\uC0C1
    - \uD50C\uB808\uC774\uC5B4\uAC00 \uC9C1\uC811 \uD754\uB4DC\uB294 \uB300\uC0C1\uC774
    \uC544\uB2C8\uB77C \uB3C4\uC2DC \uC804\uCCB4 \uBD95\uAD34\uC758 \uACB0\uACFC\uB85C
    \uC2E4\uAC01\uD558\uB294 \uCD5C\uC885 NPC."
  aiNotes: []
  backstory: "\uC120\uB300\uB85C\uBD80\uD130 \uD074\uB808\uB974\uD3F0\uC744 \uBB3C\uB824\uBC1B\uC740
    \uC601\uC8FC\uB2E4. \uAD50\uD68C\uC758 \uCD95\uBCF5, \uAE30\uC0AC\uB2E8\uC758
    \uCDA9\uC131, \uADC0\uC871\uAC00\uC758 \uC9C0\uC9C0\uB77C\uB294 \uC138 \uAE30\uB465
    \uC704\uC5D0\uC11C \uD1B5\uCE58\uB97C \uC774\uC5B4\uC628\uB2E4\uACE0 \uBBFF\uC73C\uBA70,
    \uC774 \uAE30\uB465\uC774 \uC720\uC9C0\uB418\uB294 \uD55C \uC790\uC2E0\uC758
    \uC790\uB9AC\uB294 \uD754\uB4E4\uB9AC\uC9C0 \uC54A\uB294\uB2E4\uACE0 \uD655\uC2E0\uD55C\uB2E4.
    \uAD8C\uC704\uC640 \uCCB4\uBA74\uC744 \uC911\uC694\uD558\uAC8C \uC5EC\uACA8 \uD1B5\uCE58\uC5D0
    \uC758\uBB38\uC744 \uC81C\uAE30\uD558\uB294 \uC18C\uBB38\uC5D0\uB294 \uD06C\uAC8C
    \uBC18\uC751\uD558\uC9C0 \uC54A\uC9C0\uB9CC, \uAE30\uB465 \uD558\uB098\uB77C\uB3C4
    \uD754\uB4E4\uB9B0\uB2E4\uB294 \uADFC\uAC70\uAC00 \uC81C\uC2DC\uB418\uBA74 \uADF8\uB54C\uBD80\uD130
    \uD669\uAE09\uD788 \uC0C1\uD669\uC744 \uC7AC\uD310\uB2E8\uD55C\uB2E4."
